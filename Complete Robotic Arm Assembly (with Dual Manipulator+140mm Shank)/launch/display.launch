<launch>
  <arg
    name="model" />
  <param
    name="robot_description"
    textfile="$(find Complete Robotic Arm Assembly (with Dual Manipulator+140mm Shank))/urdf/Complete Robotic Arm Assembly (with Dual Manipulator+140mm Shank).urdf" />
  <node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find Complete Robotic Arm Assembly (with Dual Manipulator+140mm Shank))/urdf.rviz" />
</launch>